@model InventoryApp.ViewModels.CategoryIndexViewModel

@{
    ViewData["Title"] = "Category Management";
}




<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2">Category Management</h1>
        <a asp-action="Add" class="btn btn-primary rounded-pill">Add New Category</a>
    </div>

   

    <table class="table table-hover table-borderless align-middle text-nowrap mb-0" id="stockTable">
        <thead class="table-light border-bottom">
            <tr>
                <th>Category Name</th>
                <th>Description</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model?.Categories != null && Model.Categories.Any())
            {
                @foreach (var item in Model.Categories)
                {
                    <tr>
                        <td><strong>@item.Name</strong></td>
                        <td>@(string.IsNullOrEmpty(item.Description) ? "N/A" : item.Description)</td>

                       
                        <td class="text-center">
                            <div class="dropdown">
                                <button class="btn btn-light btn-sm rounded-circle p-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="width: 32px; height: 32px;">
                                    <i class="bi bi-three-dots-vertical"></i> &#8942;
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li>
                                        <a class="dropdown-menu-item dropdown-item text-warning" asp-action="Edit" asp-route-id="@item.Id">
                                            <i class="bi bi-pencil me-2"></i> Edit
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-menu-item dropdown-item text-info" asp-action="Details" asp-route-id="@item.Id">
                                            <i class="bi bi-eye me-2"></i> Show Products
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-action="Delete"
                                              asp-route-id="@item.Id"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="dropdown-item text-danger">
                                                <i class="bi bi-trash me-2"></i> Delete
                                            </button>

                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center py-4 text-muted">No categories found.</td>
                </tr>
            }
        </tbody>
    </table>
    </div>


    @if (Model != null && Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchString="@ViewBag.CurrentSearch">Previous</a>
                </li>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@ViewBag.CurrentSearch">@i</a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchString="@ViewBag.CurrentSearch">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>

                        
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @if (TempData["Error"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'error',
                    title: 'Cannot Delete',
                    text: '@TempData["Error"]',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
            });
        </script>
    }

    @if (TempData["Success"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: 'Success',
                    text: '@TempData["Success"]',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
            });
        </script>
    }
}