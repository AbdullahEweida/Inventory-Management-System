@model InventoryApp.ViewModels.CategoryViewModel

@using InventoryApp.ViewModels.Products

@{
    ViewData["Title"] = "Category Details";
    var products = Model.Products as List<ProductDetailsViewModel>;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Category: @Model.Name</h2>
        <a asp-action="Index" class="btn btn-secondary">Back to Categories</a>
    </div>

    <p class="text-muted">@(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)</p>

    <h4 class="mt-4">Products in this Category (@Model.ProductsCount)</h4>
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Product Name</th>
                        <th>SKU</th>
                        <th>Unit Price</th>
                        <th>Stock Quantity</th>
                    </tr>
                </thead>
                <tbody>
                    @if (products != null && products.Any())
                    {
                        foreach (var item in Model.Products)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.SKU</td>
                                <td>@item.UnitPrice.ToString("C")</td>
                                <td>@item.StockQuantity</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-3 text-muted">No products assigned to this category yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>