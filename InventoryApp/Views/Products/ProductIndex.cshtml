@model InventoryApp.ViewModels.Products.ProductIndexViewModel

@{
    ViewData["Title"] = "Products List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Product Management</h2>
        <a asp-action="Add" class="btn btn-primary rounded-pill">
            <i class="bi bi-plus-circle"></i> Add New Product
        </a>
    </div>



    
    <form asp-action="Index" method="get" class="mb-4">
        <div class="row g-2">
            
            <div class="col-md-4">
                <input type="text"
                       name="searchString"
                       value="@Model.CurrentSearch"
                       class="form-control"
                       placeholder="Search by name or SKU..." />
            </div>

           
            <div class="col-md-3">
                <select name="categoryId"
                        asp-items="Model.CategoriesList"
                        class="form-select"
                        onchange="this.form.submit()">
                    <option value=""> All Categories </option>
                </select>
            </div>

            
            <div class="col-md-3">
                <select name="stockStatus"
                        class="form-select"
                        onchange="this.form.submit()">
                    <option value="">All Stock Status </option>
                    <option value="in" selected="@(Model.CurrentStockStatus == "in")">In Stock</option>
                    <option value="low" selected="@(Model.CurrentStockStatus == "low")">Low Stock</option>
                    <option value="out" selected="@(Model.CurrentStockStatus == "out")">Out of Stock</option>
                </select>
            </div>

            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-outline-secondary  rounded-pill w-100">Reset</a>
            </div>
        </div>
    </form>
    <div class="card border-0 shadow-sm rounded-3 mt-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-borderless align-middle text-nowrap mb-0" id="stockTable">
                    <thead class="table-light border-bottom">
        
                    <tr>
                        <th>SKU</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Unit Price</th>
                        <th>Stock</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Products != null && Model.Products.Any())
                    {
                        @foreach (var item in Model.Products)
                        {
                                bool isOutOfStock = item.StockQuantity == 0;
                                bool isLowStock = item.StockQuantity > 0 && item.StockQuantity <= item.LowStockThreshold;
                            <tr>
                                <td>@(string.IsNullOrEmpty(item.SKU) ? "N/A" : item.SKU)</td>
                                <td><strong>@item.Name</strong></td>
                                <td>@(string.IsNullOrEmpty(item.CategoryName) ? "Uncategorized" : item.CategoryName)</td>
                                <td>@item.UnitPrice.ToString("C")</td>
                                <td>@item.StockQuantity</td>
                                <td>
                                        @if (isOutOfStock)
                                        {
                                            <span class="badge bg-danger">Out of Stock</span>
                                        }
                                        else if (isLowStock)
                                        {
                                            <span class="badge bg-warning text-dark">Low Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Available</span>
                                        }
                                    <td class="text-center">
                                        <div class="dropdown">
                                            <button class="btn btn-light btn-sm rounded-circle p-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="width: 32px; height: 32px;">
                                                <i class="bi bi-three-dots-vertical"></i> &#8942;
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                <li>
                                                    <a class="dropdown-menu-item dropdown-item text-warning" asp-action="Edit" asp-route-id="@item.Id">
                                                        <i class="bi bi-pencil me-2"></i> Edit
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-menu-item dropdown-item text-info" asp-action="Details" asp-route-id="@item.Id">
                                                        <i class="bi bi-eye me-2"></i> Details
                                                    </a>
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-menu-item dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.Id">
                                                        <i class="bi bi-trash me-2"></i> Delete
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted">No products found.</td>
                        </tr>
                    }
                </tbody>
            </table>

           
            @if (Model.TotalPages > 1)
            {
                    
                    <nav aria-label="Page navigation" class="mt-3">
                        <ul class="pagination justify-content-center">

                            
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage - 1)"
                                   asp-route-searchString="@Model.CurrentSearch"
                                   asp-route-categoryId="@Model.CurrentCategory"
                                   asp-route-stockStatus="@Model.CurrentStockStatus">Previous</a>
                            </li>

                         
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@i"
                                       asp-route-searchString="@Model.CurrentSearch"
                                       asp-route-categoryId="@Model.CurrentCategory"
                                       asp-route-stockStatus="@Model.CurrentStockStatus">@i</a>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-searchString="@Model.CurrentSearch"
                                   asp-route-categoryId="@Model.CurrentCategory"
                                   asp-route-stockStatus="@Model.CurrentStockStatus">Next</a>
                            </li>

                        </ul>
                    </nav>
            }
        </div>
    </div>
</div>