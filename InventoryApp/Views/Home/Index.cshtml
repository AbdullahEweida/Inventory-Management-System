@model InventoryApp.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    var recent = Model.RecentActivities.Take(5).ToList();
    var salesProducts = Model.MostSoldProducts.Take(5).ToList();
    var outOfStockCount = Math.Max(Model.OutOfStockProductsCount, 0);
    var lowStockCount = Math.Max(Model.LowStockProductsCount, 0);
    var inStockCount = Math.Max(Model.TotalProducts - lowStockCount - outOfStockCount, 0);
    var lowStockPercent = Model.TotalProducts > 0 ? (double)lowStockCount / Model.TotalProducts * 100 : 0;
    var outOfStockPercent = Model.TotalProducts > 0 ? (double)outOfStockCount / Model.TotalProducts * 100 : 0;
    var inStockPercent = Math.Max(0, 100 - lowStockPercent - outOfStockPercent);
}

<div class="dashboard-page">
    <div class="dashboard-wrap">
        <div class="dashboard-head">
            <div>
                <h1 class="dashboard-title">Dashboard</h1>
                <p class="dashboard-subtitle">Here's what's happening with your inventory today.</p>
            </div>
            <div class="dashboard-date"><i class="bi bi-calendar3"></i>@DateTime.Now.ToString("MMM dd, yyyy") <span>–</span> @DateTime.Now.AddDays(6).ToString("MMM dd, yyyy") <i class="bi bi-chevron-down"></i></div>
        </div>

        <section class="stats-grid">
            <article class="stat-card">
                <div class="stat-copy">
                    <p class="stat-label">Total Products</p>
                    <h2 class="stat-value">@Model.TotalProducts.ToString("N0")</h2>
                    <div class="stat-trend up"><i class="bi bi-arrow-up"></i> Active <span class="muted">inventory items</span></div>
                </div>
                <span class="stat-icon icon-blue"><i class="bi bi-box-seam"></i></span>
            </article>
            <article class="stat-card">
                <div class="stat-copy">
                    <p class="stat-label">Total Sales</p>
                    <h2 class="stat-value">@Model.TotalSalesRevenue.ToString("C0")</h2>
                    <div class="stat-trend up"><i class="bi bi-arrow-up"></i> @Model.TotalSalesCount <span class="muted">transactions</span></div>
                </div>
                <span class="stat-icon icon-green"><i class="bi bi-cart3"></i></span>
            </article>
            <article class="stat-card">
                <div class="stat-copy">
                    <p class="stat-label">Total Purchases</p>
                    <h2 class="stat-value">@Model.TotalPurchasesAmount.ToString("C0")</h2>
                    <div class="stat-trend up"><i class="bi bi-arrow-up"></i> @Model.TotalPurchasesCount <span class="muted">transactions</span></div>
                </div>
                <span class="stat-icon icon-purple"><i class="bi bi-bag-check"></i></span>
            </article>
            <article class="stat-card">
                <div class="stat-copy">
                    <p class="stat-label">Low Stock Items</p>
                    <h2 class="stat-value">@Model.LowStockProductsCount.ToString("N0")</h2>
                    <div class="stat-trend down"><i class="bi bi-arrow-up"></i> @lowStockPercent.ToString("0.#")% <span class="muted">of products</span></div>
                </div>
                <span class="stat-icon icon-orange"><i class="bi bi-exclamation-triangle"></i></span>
            </article>
        </section>

        <section class="content-grid">
            <article class="panel chart-panel">
                <div class="panel-head">
                    <div>
                        <h3 class="panel-title">Sales Overview</h3>
                        <p class="panel-subtitle">Visual snapshot of your current sales performance</p>
                    </div>
                    <div class="legend"><span><i></i>This Year</span><span class="last"><i></i>Reference</span></div>
                </div>
                <div class="fake-chart" aria-hidden="true">
                    <div class="chart-y"><span>25k</span><span>20k</span><span>15k</span><span>10k</span><span>5k</span><span>0</span></div>
                    <div class="chart-column"><div class="chart-bars"><span class="bar primary" style="height: 35%"></span><span class="bar" style="height: 24%"></span></div><span class="chart-month">Jan</span></div>
                    <div class="chart-column"><div class="chart-bars"><span class="bar primary" style="height: 46%"></span><span class="bar" style="height: 31%"></span></div><span class="chart-month">Feb</span></div>
                    <div class="chart-column"><div class="chart-bars"><span class="bar primary" style="height: 52%"></span><span class="bar" style="height: 39%"></span></div><span class="chart-month">Mar</span></div>
                    <div class="chart-column"><div class="chart-bars"><span class="bar primary" style="height: 61%"></span><span class="bar" style="height: 50%"></span></div><span class="chart-month">Apr</span></div>
                    <div class="chart-column"><div class="chart-bars"><span class="bar primary" style="height: 71%"></span><span class="bar" style="height: 59%"></span></div><span class="chart-month">May</span></div>
                    <div class="chart-column"><div class="chart-bars"><span class="bar primary" style="height: 77%"></span><span class="bar" style="height: 68%"></span></div><span class="chart-month">Jun</span></div>
                    <div class="chart-column"><div class="chart-bars"><span class="bar primary" style="height: 83%"></span><span class="bar" style="height: 74%"></span></div><span class="chart-month">Jul</span></div>
                    <div class="chart-column"><div class="chart-bars"><span class="bar primary" style="height: 92%"></span><span class="bar" style="height: 84%"></span></div><span class="chart-month">Aug</span></div>
                </div>
            </article>

            <article class="panel stock-card">
                <div class="panel-head">
                    <div>
                        <h3 class="panel-title"><i class="bi bi-box-seam me-1"></i> Stock Status</h3>
                        <p class="panel-subtitle">Current inventory breakdown</p>
                    </div>
                </div>
                <div class="stock-body">
                    <div class="donut" style="--in-stock:@inStockPercent.ToString("0.##")%; --low-stock:@lowStockPercent.ToString("0.##")%;">
                        <div class="donut-center"><strong>@Model.TotalProducts.ToString("N0")</strong><span>Total Products</span></div>
                    </div>
                    <div class="stock-list">
                        <div class="stock-item"><span class="stock-dot"></span><div><div class="stock-name">In Stock</div><div class="stock-value">@inStockCount.ToString("N0") (@inStockPercent.ToString("0.#")%)</div></div></div>
                        <div class="stock-item"><span class="stock-dot orange"></span><div><div class="stock-name">Low Stock</div><div class="stock-value">@lowStockCount.ToString("N0") (@lowStockPercent.ToString("0.#")%)</div></div></div>
                        <div class="stock-item"><span class="stock-dot red"></span><div><div class="stock-name">Out of Stock</div><div class="stock-value">@outOfStockCount.ToString("N0") (@outOfStockPercent.ToString("0.#")%)</div></div></div>
                    </div>
                </div>
            </article>
        </section>

        <section class="lower-grid">
            <article class="panel">
                <div class="panel-head">
                    <div><h3 class="panel-title">Recent Activities</h3><p class="panel-subtitle">Latest transactions and updates</p></div>
                    <span class="view-link">View All</span>
                </div>
                <div class="activity-list">
                    @if (recent.Any())
                    {
                        foreach (var activity in recent)
                        {
                            var isSale = activity.Type == "Sale";
                            <div class="activity-row">
                                <span class="activity-icon @(isSale ? "icon-green" : "icon-blue")"><i class="bi @(isSale ? "bi-cart3" : "bi-truck")"></i></span>
                                <div>
                                    <div class="activity-title">@(isSale ? "New sale" : "Purchase received")</div>
                                    <div class="activity-sub">@activity.Details</div>
                                </div>
                                <div class="activity-meta"><div class="activity-date">@activity.Date.ToLocalTime().ToString("dd MMM yyyy")</div><div class="activity-amount">@activity.Amount.ToString("C0")</div><span class="activity-badge @(isSale ? "sale" : "purchase")">@(isSale ? "Completed" : "Received")</span></div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="empty-state">No recent sales or purchases found.</p>
                    }
                </div>
            </article>

            <article class="panel">
                <div class="panel-head"><div><h3 class="panel-title">Latest Orders</h3><p class="panel-subtitle">Most recent customer and supplier transactions</p></div><span class="view-link">View All</span></div>
                <div class="table-wrap">
                    <table class="order-table">
                        <thead><tr><th>Order / Txn</th><th>Details</th><th>Status</th><th class="text-end">Total</th></tr></thead>
                        <tbody>
                            @if (recent.Any())
                            {
                                var idx = 123;
                                foreach (var activity in recent)
                                {
                                    var isSale = activity.Type == "Sale";
                                    <tr>
                                        <td>#@(idx++)</td>
                                        <td>@activity.Details</td>
                                        <td><span class="status-pill @(isSale ? "completed" : "shipped")">@(isSale ? "Completed" : "Received")</span></td>
                                        <td class="text-end fw-semibold">@activity.Amount.ToString("C0")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="4" class="text-center py-4 text-muted">No transaction data yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </article>

            <div class="quick-col">
                <article class="panel quick-actions">
                    <div class="panel-head p-0 mb-3"><div><h3 class="panel-title">Quick Actions</h3></div></div>
                    <a class="quick-btn quick-blue" asp-controller="Products" asp-action="Add"><i class="bi bi-plus-lg"></i>Add New Product</a>
                    <a class="quick-btn quick-green" asp-controller="Purchase" asp-action="Create"><i class="bi bi-cart-plus"></i>Add Purchase</a>
                    <a class="quick-btn quick-purple" asp-controller="Sale" asp-action="Create"><i class="bi bi-tag"></i>Add Sale</a>
                    <a class="quick-btn quick-slate" asp-controller="Inventory" asp-action="Index"><i class="bi bi-bar-chart"></i>View Inventory</a>
                </article>

                <article class="panel top-products">
                    <div class="panel-head px-0"><div><h3 class="panel-title">Top Selling Products</h3><p class="panel-subtitle">Ranked by quantity sold</p></div><i class="bi bi-trophy-fill text-warning"></i></div>
                    @if (salesProducts.Any())
                    {
                        foreach (var product in salesProducts)
                        {
                            <div class="product-row">
                                <span class="product-thumb"><i class="bi bi-box-seam"></i></span>
                                <div><div class="product-name">@product.ProductName</div><div class="product-sold">@product.TotalQuantitySold.ToString("N0") sold</div></div>
                                <div class="product-revenue">@product.TotalRevenue.ToString("C0")</div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="empty-state">No sales data found yet.</p>
                    }
                </article>
            </div>
        </section>

        <section class="panel ai-card">
            <div class="panel-head">
                <div class="ai-heading-wrap"><i class="bi bi-robot ai-heading-icon"></i><div><h3 class="panel-title">AI Inventory Analysis</h3><p class="panel-subtitle">Get smart, real-time recommendations for your stock</p></div></div>
                <button type="button" class="ai-action" data-bs-toggle="modal" data-bs-target="#aiAnalysisModal"><i class="bi bi-stars me-1"></i>Smart Analysis</button>
            </div>
        </section>
    </div>
</div>

<!-- AI Analysis Modal -->
<div class="modal fade" id="aiAnalysisModal" tabindex="-1" aria-labelledby="aiAnalysisModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" style="border-radius: 16px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">

            <!-- الهيدر -->
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold" id="aiAnalysisModalLabel" style="color: #1e293b;">
                    <i class="bi bi-robot me-2" style="color: #7c3aed;"></i> AI Inventory Insights
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- جسم النافذة (هنا كان المشكلة غالباً) -->
            <div class="modal-body p-4">

                <!-- الترحيب -->
                <div id="aiIntro" class="text-center py-4">
                    <i class="bi bi-stars" style="font-size: 3rem; color: #cbd5e1;"></i>
                    <p class="mt-3 text-muted">Ready to analyze your current stock levels and sales trends?</p>
                </div>

                <!-- التحميل -->
                <div id="aiLoader" class="text-center py-4" style="display: none;">
                    <div class="spinner-border" style="color: #7c3aed;" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-3 text-muted fw-semibold">Analyzing your data, please wait...</p>
                </div>

                <!-- النتيجة (تأكد إن ده جوه الـ modal-body) -->
                <div id="aiContent" class="w-100" style="display: none;">
                    <!-- الجافاسكريبت هيحقن الـ HTML هنا -->
                </div>

            </div>

            <!-- الفوتر -->
            <div class="modal-footer border-top-0 pt-0 justify-content-center">
                <button type="button" id="btnRunAnalysis" class="btn text-white w-100" style="background-color: #7c3aed; border-radius: 12px; padding: 12px;">
                    <i class="bi bi-cpu me-2"></i> Generate Report
                </button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        document.getElementById('btnRunAnalysis').addEventListener('click', async function() {
            const intro = document.getElementById('aiIntro');
            const loader = document.getElementById('aiLoader');
            const content = document.getElementById('aiContent');
            const btn = this;

            intro.style.display = 'none';
            content.style.display = 'none';
            loader.style.display = 'block';
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Processing...';

            try {
                const response = await fetch('/api/AI/inventory-analysis');
                const result = await response.json();

                // بنطبع النتيجة في الكونسول عشان لو فيه خطأ نقدر نتتبعه
                console.log("API Response:", result);

                if (!response.ok || result.success === false) {
                    throw new Error(result.error || 'Error Happend');
                }

                // الداتا الفعلية اللي راجعة من الجيميني
                const aiData = result.data;

                if (!aiData || !aiData.summary) {
                    throw new Error('The Data is not in formal.');
                }

                // 1. رسم قسم الإحصائيات (Summary)
                let summaryHtml = `
                            <div class="row text-center mb-4 g-2">
                                <div class="col-6 col-md-3">
                                    <div class="p-3 bg-light rounded shadow-sm border">
                                        <h6 class="text-muted mb-1" style="font-size: 0.8rem;">Total Products</h6>
                                        <h4 class="mb-0 fw-bold">${aiData.summary.totalProducts}</h4>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="p-3 rounded shadow-sm border" style="background-color: #f0fdf4;">
                                        <h6 class="text-success mb-1" style="font-size: 0.8rem;">Healthy</h6>
                                        <h4 class="mb-0 fw-bold text-success">${aiData.summary.healthyProducts}</h4>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="p-3 rounded shadow-sm border" style="background-color: #fffbeb;">
                                        <h6 class="text-warning mb-1" style="font-size: 0.8rem;">Low Stock</h6>
                                        <h4 class="mb-0 fw-bold text-warning">${aiData.summary.lowStockProducts}</h4>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="p-3 rounded shadow-sm border" style="background-color: #fef2f2;">
                                        <h6 class="text-danger mb-1" style="font-size: 0.8rem;">Critical</h6>
                                        <h4 class="mb-0 fw-bold text-danger">${aiData.summary.criticalProducts}</h4>
                                    </div>
                                </div>
                            </div>
                        `;

                // 2. رسم قسم الإجراءات العاجلة (Priority Actions)
                let actionsHtml = '';
                if (aiData.priorityActions && aiData.priorityActions.length > 0) {
                    actionsHtml = `
                                <h6 class="fw-bold text-danger mb-3"><i class="bi bi-exclamation-octagon-fill me-2"></i>Priority Actions</h6>
                                <ul class="list-group mb-4 shadow-sm">
                                    ${aiData.priorityActions.map(action => `<li class="list-group-item list-group-item-danger border-0 mb-1 rounded"><i class="bi bi-arrow-right-short me-1"></i>${action}</li>`).join('')}
                                </ul>
                            `;
                }

                // 3. رسم جدول المنتجات والتوصيات (Product Recommendations)
                let productsHtml = `
                            <h6 class="fw-bold text-primary mb-3"><i class="bi bi-box-seam me-2"></i>Product Insights</h6>
                            <div class="table-responsive mb-4 shadow-sm rounded border">
                                <table class="table table-hover mb-0" style="font-size: 0.9rem;">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Product</th>
                                            <th>Status</th>
                                            <th>AI Recommendation</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                        `;

                aiData.products.forEach(p => {
                    let badgeClass = p.status === 'Critical' ? 'bg-danger' : (p.status === 'Low' ? 'bg-warning text-dark' : 'bg-success');
                    productsHtml += `
                                        <tr>
                                            <td class="fw-semibold">${p.name} <span class="d-block text-muted" style="font-size: 0.75rem;">SKU: ${p.sku} | Stock: ${p.stockQuantity}</span></td>
                                            <td class="align-middle"><span class="badge ${badgeClass}">${p.status}</span></td>
                                            <td class="align-middle text-muted">${p.recommendation}</td>
                                        </tr>
                            `;
                });

                productsHtml += `
                                    </tbody>
                                </table>
                            </div>
                        `;

                // 4. رسم قسم التوصيات العامة (General Recommendations)
                let generalHtml = '';
                if (aiData.generalRecommendations && aiData.generalRecommendations.length > 0) {
                    generalHtml = `
                                <h6 class="fw-bold mt-2" style="color: #7c3aed;"><i class="bi bi-lightbulb-fill me-2"></i>General Recommendations</h6>
                                <ul class="list-group list-group-flush shadow-sm rounded border">
                                    ${aiData.generalRecommendations.map(rec => `<li class="list-group-item"><i class="bi bi-check2-circle text-success me-2"></i>${rec}</li>`).join('')}
                                </ul>
                             `;
                }

                // تجميع كل الأقسام وحقنها في الـ Modal
                content.innerHTML = summaryHtml + actionsHtml + productsHtml + generalHtml;
                content.style.display = 'block';
                btn.style.display = 'none';

            } catch (error) {
                console.error("Caught Error:", error);

                content.innerHTML = `
                            <div class="alert alert-danger border-0 shadow-sm mt-3">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <strong>حدث خطأ:</strong> <br>
                                <span style="font-size: 0.9rem;">${error.message}</span>
                            </div>
                        `;

                document.getElementById('aiIntro').style.display = 'none';
                content.style.display = 'block';
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-arrow-clockwise me-2"></i> Try Again';
            } finally {
                loader.style.display = 'none';
            }
        });

        // ريست للنافذة لما تتقفل
        const aiModalElement = document.getElementById('aiAnalysisModal');
        aiModalElement.addEventListener('hidden.bs.modal', event => {
            document.getElementById('aiIntro').style.display = 'block';
            document.getElementById('aiContent').style.display = 'none';
            document.getElementById('aiLoader').style.display = 'none';

            const btn = document.getElementById('btnRunAnalysis');
            btn.style.display = 'block';
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-cpu me-2"></i> Generate Report';
        });
    </script>
}
