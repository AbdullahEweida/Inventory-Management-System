@model InventoryApp.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .dashboard-page {
        background: #f5f7fb;
        min-height: 100vh;
        padding: 32px 0 50px;
    }

    .dashboard-title {
        font-size: 2rem;
        font-weight: 800;
        color: #16213e;
        margin-bottom: 4px;
    }

    .dashboard-subtitle {
        color: #6b7280;
        margin: 0;
    }

    .dashboard-date {
        color: #64748b;
        font-size: 0.9rem;
    }

    .stat-card {
        border: 0;
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
        height: 100%;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 30px rgba(15, 23, 42, 0.12);
    }

    .stat-card .card-body {
        padding: 22px;
    }

    .stat-label {
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .stat-value {
        color: #172554;
        font-size: 1.8rem;
        font-weight: 800;
        margin: 0;
    }

    .stat-icon {
        width: 54px;
        height: 54px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
    }

    .icon-blue { background: #e0ecff; color: #2563eb; }
    .icon-purple { background: #f0e7ff; color: #7c3aed; }
    .icon-orange { background: #fff0dd; color: #ea580c; }
    .icon-cyan { background: #dff8fa; color: #0891b2; }
    .icon-red { background: #ffe4e6; color: #e11d48; }
    .icon-green { background: #dcfce7; color: #16a34a; }

    .summary-card {
        border: 0;
        border-radius: 18px;
        overflow: hidden;
        height: 100%;
        color: white;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
    }

    .purchase-card {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
    }

    .sales-card {
        background: linear-gradient(135deg, #16a34a, #15803d);
    }

    .summary-card .card-body {
        padding: 24px;
    }

    .summary-card .summary-title {
        opacity: 0.88;
        margin-bottom: 10px;
        font-weight: 600;
    }

    .summary-card .summary-value {
        font-size: 2rem;
        font-weight: 800;
        margin: 0;
    }

    .summary-card .summary-note {
        opacity: 0.85;
        font-size: 0.88rem;
        margin: 6px 0 0;
    }

    .dashboard-panel {
        border: 0;
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
        overflow: hidden;
        height: 100%;
    }

    .dashboard-panel .card-header {
        background: white;
        border-bottom: 1px solid #edf0f5;
        padding: 18px 22px;
    }

    .panel-title {
        color: #1e293b;
        font-size: 1.05rem;
        font-weight: 750;
        margin: 0;
    }

    .panel-subtitle {
        color: #94a3b8;
        font-size: 0.82rem;
        margin: 4px 0 0;
    }

    .dashboard-panel .card-body {
        padding: 0;
    }

    .dashboard-table {
        margin-bottom: 0;
    }

    .dashboard-table thead th {
        background: #f8fafc;
        color: #64748b;
        border-bottom: 1px solid #edf0f5;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        padding: 13px 18px;
        text-transform: uppercase;
    }

    .dashboard-table tbody td {
        border-color: #f1f5f9;
        color: #334155;
        padding: 15px 18px;
        vertical-align: middle;
    }

    .activity-badge {
        border-radius: 20px;
        font-size: 0.74rem;
        font-weight: 700;
        padding: 6px 10px;
    }

    .empty-state {
        color: #94a3b8;
        padding: 46px 20px;
        text-align: center;
        margin: 0;
    }

    .empty-state i {
        display: block;
        font-size: 2rem;
        margin-bottom: 12px;
    }

    @@media (max-width: 767.98px) {
        .dashboard-page {
            padding-top: 20px;
        }

        .dashboard-title {
            font-size: 1.65rem;
        }
    }
</style>

<div class="dashboard-page">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
            <div>
                <h1 class="dashboard-title">Inventory Dashboard</h1>
                <p class="dashboard-subtitle">A real-time overview of your stock, purchasing, and sales performance.</p>
            </div>

            <div class="dashboard-date mt-3 mt-md-0">
                <i class="bi bi-calendar3 me-1"></i>
                @DateTime.Now.ToString("dddd, dd MMMM yyyy")
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-sm-6 col-lg-3">
                <div class="card stat-card">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <p class="stat-label">Total Products</p>
                            <h2 class="stat-value">@Model.TotalProducts</h2>
                        </div>
                        <div class="stat-icon icon-blue">
                            <i class="bi bi-box-seam"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="card stat-card">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <p class="stat-label">Categories</p>
                            <h2 class="stat-value">@Model.TotalCategories</h2>
                        </div>
                        <div class="stat-icon icon-purple">
                            <i class="bi bi-grid-1x2"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="card stat-card">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <p class="stat-label">Suppliers</p>
                            <h2 class="stat-value">@Model.TotalSuppliers</h2>
                        </div>
                        <div class="stat-icon icon-orange">
                            <i class="bi bi-truck"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="card stat-card">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <p class="stat-label">Items in Stock</p>
                            <h2 class="stat-value">@Model.TotalStockQuantity</h2>
                        </div>
                        <div class="stat-icon icon-cyan">
                            <i class="bi bi-boxes"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="card stat-card">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <p class="stat-label">Low-Stock Alerts</p>
                            <h2 class="stat-value text-danger">@Model.LowStockProductsCount</h2>
                        </div>
                        <div class="stat-icon icon-red">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card summary-card purchase-card">
                    <div class="card-body">
                        <p class="summary-title">
                            <i class="bi bi-cart-plus me-2"></i>Total Purchases
                        </p>
                        <h2 class="summary-value">@Model.TotalPurchasesAmount.ToString("C")</h2>
                        <p class="summary-note">@Model.TotalPurchasesCount purchase transaction(s)</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card summary-card sales-card">
                    <div class="card-body">
                        <p class="summary-title">
                            <i class="bi bi-graph-up-arrow me-2"></i>Total Sales Revenue
                        </p>
                        <h2 class="summary-value">@Model.TotalSalesRevenue.ToString("C")</h2>
                        <p class="summary-note">@Model.TotalSalesCount sale transaction(s)</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card dashboard-panel">
                    <div class="card-header">
                        <h5 class="panel-title">Recent Activity</h5>
                        <p class="panel-subtitle">Latest sales and stock purchases</p>
                    </div>

                    <div class="card-body">
                        @if (Model.RecentActivities.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover dashboard-table">
                                    <thead>
                                        <tr>
                                            <th>Type</th>
                                            <th>Details</th>
                                            <th>Date</th>
                                            <th class="text-end">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var activity in Model.RecentActivities)
                                        {
                                            <tr>
                                                <td>
                                                    @if (activity.Type == "Sale")
                                                    {
                                                        <span class="badge bg-success activity-badge">
                                                            <i class="bi bi-arrow-up-right me-1"></i>Sale
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-primary activity-badge">
                                                            <i class="bi bi-arrow-down-left me-1"></i>Purchase
                                                        </span>
                                                    }
                                                </td>
                                                <td>@activity.Details</td>
                                                <td>@activity.Date.ToLocalTime().ToString("dd MMM yyyy")</td>
                                                <td class="text-end fw-semibold">@activity.Amount.ToString("C")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="empty-state">
                                <i class="bi bi-clock-history"></i>
                                No recent sales or purchases found.
                            </p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card dashboard-panel">
                    <div class="card-header">
                        <h5 class="panel-title">Most Sold Products</h5>
                        <p class="panel-subtitle">Top products ranked by quantity sold</p>
                    </div>

                    <div class="card-body">
                        @if (Model.MostSoldProducts.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover dashboard-table">
                                    <thead>
                                        <tr>
                                            <th>Product</th>
                                            <th class="text-center">Quantity Sold</th>
                                            <th class="text-end">Revenue</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var product in Model.MostSoldProducts)
                                        {
                                            <tr>
                                                <td class="fw-semibold">@product.ProductName</td>
                                                <td class="text-center">
                                                    <span class="badge text-bg-light">@product.TotalQuantitySold</span>
                                                </td>
                                                <td class="text-end fw-semibold text-success">@product.TotalRevenue.ToString("C")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="empty-state">
                                <i class="bi bi-bar-chart"></i>
                                No sales data found yet.
                            </p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>