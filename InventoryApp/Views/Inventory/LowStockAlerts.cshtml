@model IEnumerable<InventoryApp.Models.Product>

@{
    ViewData["Title"] = "Low Stock Alerts";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<style>
    .pulse-danger {
        animation: pulse-red 2s infinite;
    }

    @@keyframes pulse-red {
        0% {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(220, 53, 69, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
        }
    }
</style>

<div class="container mt-4">
    <div class="alert alert-danger d-flex align-items-center shadow-sm border-0 rounded-4 p-4 mb-5" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-1 me-3"></i>
        <div>
            <h3 class="alert-heading fw-bold mb-1">Action Required!</h3>
            <p class="mb-0 fs-5">The following items have dropped below their minimum stock threshold and require immediate replenishment.</p>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                var cardClass = item.StockQuantity == 0 ? "border-danger pulse-danger" : "border-warning";
                var iconClass = item.StockQuantity == 0 ? "bi-x-octagon text-danger" : "bi-exclamation-circle text-warning";

                <div class="col">
                    <div class="card h-100 shadow-sm rounded-4 @cardClass" style="border-width: 2px;">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <span class="badge bg-secondary mb-2">@item.SKU</span>
                                    <h5 class="card-title fw-bold">@item.Name</h5>
                                </div>
                                <i class="bi @iconClass fs-2"></i>
                            </div>

                            <div class="d-flex justify-content-between align-items-center bg-light p-3 rounded-3 mt-3">
                                <div class="text-center">
                                    <small class="text-muted d-block text-uppercase fw-bold">Current</small>
                                    <span class="fs-4 fw-bold @(item.StockQuantity == 0 ? "text-danger" : "text-dark")">@item.StockQuantity</span>
                                </div>
                                <div class="text-center border-start ps-3">
                                    <small class="text-muted d-block text-uppercase fw-bold">Threshold</small>
                                    <span class="fs-5 text-muted">@item.LowStockThreshold</span>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3 text-center">
                            <button class="btn btn-outline-dark btn-sm rounded-pill px-4">
                                 <a class="text-decoration-none text-dark" asp-controller="Products" asp-action="Edit" asp-route-id="@item.ID">Order Now</a>
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                <h3 class="mt-3 text-muted">All clear! Your stock levels are healthy.</h3>
                <a asp-action="Index" class="btn btn-outline-primary mt-3 rounded-pill px-4">Back to Inventory</a>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <nav aria-label="Low stock pagination" class="d-flex justify-content-center">
            <ul class="pagination shadow-sm">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="LowStockAlerts" asp-route-page="@(currentPage - 1)">Previous</a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="LowStockAlerts" asp-route-page="@i">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="LowStockAlerts" asp-route-page="@(currentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>