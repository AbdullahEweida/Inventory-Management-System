@model InventoryApp.Models.Supplier

@{
    ViewData["Title"] = "Supplier Details";
}

<div class="container mt-5">
    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-header bg-info text-white py-3">
            <h4 class="mb-0"><i class="bi bi-info-circle-fill me-2"></i>Supplier Details</h4>
        </div>
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted">Company Name:</dt>
                <dd class="col-sm-9 fw-bold fs-5">@Model.Name</dd>

                <dt class="col-sm-3 text-muted">Contact Person:</dt>
                <dd class="col-sm-9">@Model.ContactName</dd>

                <dt class="col-sm-3 text-muted">Phone Number:</dt>
                <dd class="col-sm-9">@Model.Phone</dd>

                <dt class="col-sm-3 text-muted">Email Address:</dt>
                <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Email) ? "N/A" : Model.Email)</dd>

                <dt class="col-sm-3 text-muted">Address:</dt>
                <dd class="col-sm-9">@Model.Address</dd>
            </dl>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-header bg-secondary text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-receipt me-2"></i>Purchase History</h5>
        </div>
        <div class="card-body p-0">

            @if (Model.Purchases != null && Model.Purchases.Any())
            {
                <div class="accordion accordion-flush" id="purchasesAccordion">

                    @foreach (var purchase in Model.Purchases)
                    {
                        <div class="accordion-item border-bottom">
                            <h2 class="accordion-header" id="heading-@purchase.Id">
                                <button class="accordion-button collapsed bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@purchase.Id" aria-expanded="false" aria-controls="collapse-@purchase.Id">
                                    <div class="d-flex justify-content-between w-100 pe-3">
                                        <span><strong>Invoice #@purchase.Id.ToString().Substring(0, 8)</strong></span>
                                        <span class="badge bg-secondary text-white">@purchase.Date.ToString("dd MMM yyyy")</span>
                                    </div>
                                </button>
                            </h2>
                            <div id="collapse-@purchase.Id" class="accordion-collapse collapse" aria-labelledby="heading-@purchase.Id" data-bs-parent="#purchasesAccordion">
                                <div class="accordion-body p-3">

                                    @if (purchase.PurchaseItems != null && purchase.PurchaseItems.Any())
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-hover table-borderless align-middle text-nowrap mb-0" id="stockTable">
                                                <thead class="table-light border-bottom">
                                                    <tr>
                                                        <th>Product Name</th>
                                                        <th class="text-center">Quantity</th>
                                                        <th class="text-end">Unit Cost</th>
                                                        <th class="text-end">Subtotal</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @{
                                                        decimal totalAmount = 0;
                                                    }

                                                    @foreach (var item in purchase.PurchaseItems)
                                                    {
                                                        decimal subtotal = item.Quantity * item.UnitPrice;
                                                        totalAmount += subtotal;

                                                        <tr>
                                                            <td class="fw-bold">
                                                                @(item.Product?.Name ?? "Unknown Product")
                                                            </td>
                                                            <td class="text-center">@item.Quantity</td>
                                                            <td class="text-end">@item.UnitPrice.ToString("C")</td>
                                                            <td class="text-end fw-bold text-success">@subtotal.ToString("C")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                                <tfoot>
                                                    <tr class="table-light">
                                                        <td colspan="3" class="text-end fw-bold">Total Invoice Amount:</td>
                                                        <td class="text-end fw-bold fs-6 text-primary">@totalAmount.ToString("C")</td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted mb-0 small"><i class="bi bi-exclamation-circle me-1"></i> No items found in this purchase.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-bag-x fs-1 mb-3 d-block text-secondary"></i>
                    <h5>No Purchases Yet</h5>
                    <p class="mb-0">This supplier hasn't provided any products yet.</p>
                </div>
            }
        </div>
    </div>
        
        <div class="card-footer bg-light p-3">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-primary  rounded-pill float-end px-4">
                <i class="bi bi-pencil-square me-1"></i> Edit
            </a>
        </div>
    </div>
</div>