@model IEnumerable<InventoryApp.Models.Supplier>

@{
    ViewData["Title"] = "Suppliers List";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Suppliers Management</h2>
        <a asp-action="Create" class="btn btn-primary rounded-pill" aria-label="Add new supplier">
            <i class="bi bi-plus-circle"></i> Add New Supplier
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3 mt-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-borderless align-middle text-nowrap mb-0" id="stockTable">
                    <thead class="table-light border-bottom">
                <tr>
                    <th>Name</th>
                    <th>Contact Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Address</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.Name</td>
                            <td>@item.ContactName</td>
                            <td>@item.Phone</td>
                            <td>@(string.IsNullOrEmpty(item.Email) ? "N/A" : item.Email)</td>
                            <td>@item.Address</td>
                            <td class="text-center">
                                <div class="btn-group" role="group" aria-label="Supplier Actions">
                                    <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-outline-warning" aria-label="Edit @item.Name">Edit</a>
                                    <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-outline-info" aria-label="View details of @item.Name">Details</a>
                                    <form asp-action="Delete" asp-route-id="@item.ID" method="post" class="d-inline delete-form">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No suppliers found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <nav aria-label="Supplier pagination" class="mt-4">
            <ul class="pagination justify-content-center">

                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @if (TempData["Error"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'error',
                    title: 'Cannot Delete',
                    text: '@TempData["Error"]',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
            });
        </script>
    }

    @if (TempData["Success"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: 'Success',
                    text: '@TempData["Success"]',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
            });
        </script>
    }
}
