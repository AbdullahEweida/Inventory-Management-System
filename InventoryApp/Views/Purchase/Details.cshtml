@model InventoryApp.Models.Purchase

@{
    ViewData["Title"] = "Purchase Details";
}

<div class="container mt-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Purchase Details</h2>
            <p class="text-muted mb-0">
                Invoice #@Model.Id.ToString().Substring(0, 8)
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            ← Back to Purchase History
        </a>
    </div>


    <!-- Purchase Information -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Purchase Information</h5>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">
                    <strong>Invoice Number</strong>
                    <p class="text-muted">
                        @Model.Id.ToString().Substring(0, 8)
                    </p>
                </div>

                <div class="col-md-4">
                    <strong>Supplier</strong>
                    <p class="text-muted">
                        @(Model.Supplier?.Name ?? "Unknown Supplier")
                    </p>
                </div>

                <div class="col-md-4">
                    <strong>Purchase Date</strong>
                    <p class="text-muted">
                        @Model.Date.ToString("dd MMM yyyy HH:mm")
                    </p>
                </div>

            </div>

        </div>
    </div>


    <!-- Purchase Items -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Purchased Products</h5>
        </div>

        <div class="card-body p-0">

            @if (Model.PurchaseItems != null && Model.PurchaseItems.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-borderless align-middle text-nowrap mb-0" id="stockTable">
                        <thead class="table-light border-bottom">

                            <tr>
                                <th>#</th>
                                <th>Product</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-end">Unit Price</th>
                                <th class="text-end">Subtotal</th>
                            </tr>

                        </thead>

                        <tbody>

                            @{
                                int counter = 1;
                            }

                            @foreach (var item in Model.PurchaseItems)
                            {
                                decimal subtotal = item.Quantity * item.UnitPrice;

                                <tr>

                                    <td>
                                        @counter
                                    </td>

                                    <td class="fw-bold">
                                        @(item.Product?.Name ?? "Unknown Product")
                                    </td>

                                    <td class="text-center">
                                        @item.Quantity
                                    </td>

                                    <td class="text-end">
                                        @item.UnitPrice.ToString("C")
                                    </td>

                                    <td class="text-end fw-bold">
                                        @subtotal.ToString("C")
                                    </td>

                                </tr>

                                counter++;
                            }

                        </tbody>

                        <tfoot>

                            <tr class="table-light">

                                <td colspan="4"
                                    class="text-end fw-bold">
                                    Total Purchase:
                                </td>

                                <td class="text-end fw-bold fs-5">
                                    @Model.TotalPrice.ToString("C")
                                </td>

                            </tr>

                        </tfoot>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center p-5">

                    <p class="text-muted mb-0">
                        No products found in this purchase.
                    </p>

                </div>
            }

        </div>
    </div>


    <!-- Bottom Buttons -->
    <div class="mt-4">

        <a asp-action="Index"
           class="btn btn-secondary  rounded-pill">
            Back to History
        </a>

    </div>

</div>