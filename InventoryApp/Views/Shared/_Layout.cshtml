<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InventoryApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InventoryApp.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><i class="bi bi-box-seam"></i></span>
                <span class="brand-text">
                    <span class="brand-name">Inventory<span>Pro</span></span>
                    <span class="brand-subtitle">Smart Inventory Management</span>
                </span>
            </a>

            <nav class="sidebar-nav" aria-label="Main navigation">
                <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span>
                </a>
                <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Products" ? "active" : "")" asp-controller="Products" asp-action="Index">
                    <i class="bi bi-box-seam"></i><span>Products</span>
                </a>
                <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Categories" ? "active" : "")" asp-controller="Categories" asp-action="Index">
                    <i class="bi bi-grid"></i><span>Categories</span>
                </a>
                <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Supplier" ? "active" : "")" asp-controller="Supplier" asp-action="Index">
                    <i class="bi bi-people"></i><span>Suppliers</span>
                </a>
                <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Sale" ? "active" : "")" asp-controller="Sale" asp-action="Index">
                    <i class="bi bi-cart3"></i><span>Sales</span>
                </a>
                <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Purchase" ? "active" : "")" asp-controller="Purchase" asp-action="Index">
                    <i class="bi bi-bag-check"></i><span>Purchases</span>
                </a>
                <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Inventory" ? "active" : "")" asp-controller="Inventory" asp-action="Index">
                    <i class="bi bi-boxes"></i><span>Stock</span>
                </a>
            </nav>

            <div class="sidebar-status">
                <div class="status-dot"></div>
                <div>
                    <div class="status-title">System Online</div>
                    <div class="status-time">Last updated: @DateTime.Now.ToString("MMM dd, yyyy HH:mm")</div>
                </div>
            </div>
        </aside>

        <section class="app-main">
            <header class="app-topbar">
                <form class="topbar-search" asp-controller="Products" asp-action="Index" method="get" role="search">
                    <button class="topbar-search-submit" type="submit" aria-label="Search">
                        <i class="bi bi-search"></i>
                    </button>
                    <input name="searchString" type="search" placeholder="Search for products or SKU..." aria-label="Search products" autocomplete="off" />
                </form>
                <div class="topbar-actions">
                    <div class="notification-wrap">
                        <button class="icon-button notification-button" id="notificationButton" type="button" aria-label="Notifications" aria-expanded="false" aria-controls="notificationPanel">
                            <i class="bi bi-bell"></i><span class="notification-count" id="notificationCount" hidden>0</span>
                        </button>
                        <div class="notification-panel" id="notificationPanel" hidden>
                            <div class="notification-panel-head">
                                <div>
                                    <strong>Notifications</strong>
                                    <span id="notificationSummary">Checking for alerts...</span>
                                </div>
                                <button class="notification-close" id="notificationClose" type="button" aria-label="Close notifications">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                            <div class="notification-list" id="notificationList" aria-live="polite">
                                <div class="notification-empty">Loading alerts...</div>
                            </div>
                            <a class="notification-footer" asp-controller="Inventory" asp-action="LowStockAlerts">View all stock alerts <i class="bi bi-arrow-right"></i></a>
                        </div>
                    </div>
                </div>
            </header>

            <main role="main" class="app-content">
                @RenderBody()
            </main>
        </section>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
