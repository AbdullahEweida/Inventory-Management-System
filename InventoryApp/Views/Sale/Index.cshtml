@model IEnumerable<InventoryApp.Models.Sale>

@{
    ViewData["Title"] = "Sales History";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Sales History</h2>
            <p class="text-muted">View all sales transactions</p>
        </div>

        <a asp-action="Create" class="btn btn-primary rounded-pill">
            <i class="bi bi-plus-circle me-1"></i>
            New Sale
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-3 mt-3">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-borderless align-middle text-nowrap mb-0" id="stockTable">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th>Invoice #</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th>Items</th>
                                <th>Total</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var sale in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @sale.ID.ToString().Substring(0, 8)
                                        </strong>
                                    </td>

                                    <td>
                                        @(sale.CustomerInfo ?? "Unknown Customer")
                                    </td>

                                    <td>
                                        @sale.Date.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @(sale.Sale_Items?.Count ?? 0)
                                    </td>

                                    <td class="fw-bold">
                                        @sale.TotalAmount.ToString("C")
                                    </td>

                                    <td>
                                        <a asp-action="Details"
                                           asp-route-id="@sale.ID"
                                           class="btn btn-sm btn-outline-primary">
                                            Details
                                        </a>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">

            <div class="card-body text-center p-5">

                <i class="bi bi-receipt fs-1 text-muted"></i>

                <h4 class="mt-3">
                    No Sales Found
                </h4>

                <p class="text-muted">
                    There are no sales transactions yet.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">
                    Create First Sale
                </a>

            </div>

        </div>
    }

</div>